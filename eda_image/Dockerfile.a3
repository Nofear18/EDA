FROM crpi-lmega5fbvej4u3db.cn-shanghai.personal.cr.aliyuncs.com/novigrad/eda:v0.1

USER 0

# CentOS 7 needs a working yum repo for bootstrap tools.
RUN if command -v yum >/dev/null 2>&1; then \
      mkdir -p /etc/yum.repos.d/backup && \
      mv /etc/yum.repos.d/*.repo /etc/yum.repos.d/backup/ 2>/dev/null || true && \
      printf '%s\n' \
'[base]' \
'name=CentOS-7.9.2009 - Base - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/os/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
'' \
'[updates]' \
'name=CentOS-7.9.2009 - Updates - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/updates/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
'' \
'[extras]' \
'name=CentOS-7.9.2009 - Extras - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/extras/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
> /etc/yum.repos.d/CentOS-Vault.repo && \
      yum clean all && \
      yum makecache && \
      yum install -y curl ca-certificates bzip2 && \
      yum clean all; \
    else \
      echo "ERROR: this Dockerfile expects CentOS/yum" && \
      exit 1; \
    fi

# Install a modern Python independently. Do not replace /usr/bin/python.
RUN curl -fsSL -o /tmp/miniconda.sh https://repo.anaconda.com/miniconda/Miniconda3-py310_23.5.2-0-Linux-x86_64.sh && \
    bash /tmp/miniconda.sh -b -p /opt/python && \
    rm -f /tmp/miniconda.sh && \
    /opt/python/bin/python -m pip install --no-cache-dir --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple

ENV PATH="/opt/python/bin:${PATH}"

WORKDIR /opt/eda-sandbox

COPY . /opt/eda-sandbox

RUN cp /opt/eda-sandbox/bin/claude /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude

RUN /opt/python/bin/python -m pip install \
    --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --target /opt/eda-sandbox/python_deps \
    -r /opt/eda-sandbox/requirements-sandbox.txt

ENV PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps"

RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'cd /opt/eda-sandbox' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'exec /opt/python/bin/python -m science_eda.sandbox.server --config science_eda/sandbox/science_eda.example.yaml' \
> /usr/local/bin/start-eda-sandbox && chmod +x /usr/local/bin/start-eda-sandbox

RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'cd /opt/eda-sandbox' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'exec /opt/python/bin/python -m science_eda.sandbox.interactive_mcp_server "$@"' \
> /usr/local/bin/eda-sandbox-mcp && chmod +x /usr/local/bin/eda-sandbox-mcp

# Container entrypoint:
# 1. start sandbox daemon in background
# 2. wait until /v1/capabilities is ready
# 3. configure Claude Code MCP server named eda-sandbox
# 4. run the container command, default /bin/bash
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'' \
'echo "[entrypoint] starting eda sandbox daemon..."' \
'start-eda-sandbox > /tmp/eda-sandbox.log 2>&1 &' \
'EDA_SANDBOX_PID=$!' \
'' \
'for i in $(seq 1 60); do' \
'  if curl -fsS http://127.0.0.1:8765/v1/capabilities >/dev/null 2>&1; then' \
'    echo "[entrypoint] eda sandbox daemon is ready"' \
'    break' \
'  fi' \
'  if ! kill -0 "$EDA_SANDBOX_PID" >/dev/null 2>&1; then' \
'    echo "[entrypoint] eda sandbox daemon exited unexpectedly"' \
'    cat /tmp/eda-sandbox.log || true' \
'    exit 1' \
'  fi' \
'  sleep 1' \
'done' \
'' \
'if ! curl -fsS http://127.0.0.1:8765/v1/capabilities >/dev/null 2>&1; then' \
'  echo "[entrypoint] eda sandbox daemon did not become ready"' \
'  cat /tmp/eda-sandbox.log || true' \
'  exit 1' \
'fi' \
'' \
'echo "[entrypoint] ensuring Claude Code onboarding config..."' \
'mkdir -p /home/host' \
'/opt/python/bin/python - <<'"'"'PY'"'"'' \
'import json' \
'from pathlib import Path' \
'path = Path("/home/host/.claude.json")' \
'if path.exists():' \
'    try:' \
'        data = json.loads(path.read_text(encoding="utf-8"))' \
'    except json.JSONDecodeError:' \
'        data = {}' \
'else:' \
'    data = {}' \
'data["hasCompletedOnboarding"] = True' \
'path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")' \
'PY' \
'if command -v claude >/dev/null 2>&1; then' \
'  echo "[entrypoint] configuring Claude Code MCP server: eda-sandbox"' \
'  claude mcp remove eda-sandbox --scope user >/dev/null 2>&1 || true' \
'  claude mcp add --transport stdio --scope user eda-sandbox -- /usr/local/bin/eda-sandbox-mcp --endpoint http://127.0.0.1:8765 >/dev/null 2>&1 || true' \
'fi' \
'' \
'echo "[entrypoint] ready. sandbox log: /tmp/eda-sandbox.log"' \
'exec "$@"' \
> /usr/local/bin/eda-container-entrypoint && chmod +x /usr/local/bin/eda-container-entrypoint

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/eda-container-entrypoint"]
CMD ["/bin/bash"]