FROM crpi-lmega5fbvej4u3db.cn-shanghai.personal.cr.aliyuncs.com/novigrad/eda:v0.1

USER 0

# CentOS 7 needs a working yum repo for bootstrap tools.
RUN if command -v yum >/dev/null 2>&1; then \
      mkdir -p /etc/yum.repos.d/backup && \
      mv /etc/yum.repos.d/*.repo /etc/yum.repos.d/backup/ 2>/dev/null || true && \
      printf '%s\n' \
'[base]' \
'name=CentOS-7.9.2009 - Base - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/os/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
'' \
'[updates]' \
'name=CentOS-7.9.2009 - Updates - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/updates/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
'' \
'[extras]' \
'name=CentOS-7.9.2009 - Extras - Aliyun Vault' \
'baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009/extras/$basearch/' \
'enabled=1' \
'gpgcheck=0' \
> /etc/yum.repos.d/CentOS-Vault.repo && \
      yum clean all && \
      yum makecache && \
      yum install -y curl ca-certificates bzip2 && \
      yum clean all; \
    else \
      echo "ERROR: this Dockerfile expects CentOS/yum" && \
      exit 1; \
    fi

# Install a modern Python independently. Do not replace /usr/bin/python.
RUN curl -fsSL -o /tmp/miniconda.sh https://repo.anaconda.com/miniconda/Miniconda3-py310_23.5.2-0-Linux-x86_64.sh && \
    bash /tmp/miniconda.sh -b -p /opt/python && \
    rm -f /tmp/miniconda.sh && \
    /opt/python/bin/python -m pip install --no-cache-dir --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple

ENV PATH="/opt/python/bin:${PATH}"

WORKDIR /opt/eda-sandbox

COPY . /opt/eda-sandbox

RUN cp /opt/eda-sandbox/bin/claude /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude

RUN /opt/python/bin/python -m pip install \
    --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --target /opt/eda-sandbox/python_deps \
    -r /opt/eda-sandbox/requirements-sandbox.txt

ENV PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps"

RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'cd /opt/eda-sandbox' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'PORT="${EDA_SANDBOX_PORT:-8765}"' \
'CONFIG_PATH="/tmp/science_eda.sandbox.${PORT}.yaml"' \
'/opt/python/bin/python - <<PY' \
'import os' \
'import yaml' \
'from pathlib import Path' \
'port = int(os.environ.get("EDA_SANDBOX_PORT", "8765"))' \
'source = Path("/opt/eda-sandbox/science_eda/sandbox/science_eda.example.yaml")' \
'target = Path(f"/tmp/science_eda.sandbox.{port}.yaml")' \
'data = yaml.safe_load(source.read_text(encoding="utf-8")) or {}' \
'sandbox = data.setdefault("sandbox", {})' \
'sandbox["server_host"] = "127.0.0.1"' \
'sandbox["server_port"] = port' \
'target.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True), encoding="utf-8")' \
'PY' \
'exec /opt/python/bin/python -m science_eda.sandbox.server --config "$CONFIG_PATH"' \
> /usr/local/bin/start-eda-sandbox && chmod +x /usr/local/bin/start-eda-sandbox

RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'cd /opt/eda-sandbox' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'exec /opt/python/bin/python -m science_eda.sandbox.interactive_mcp_server "$@"' \
> /usr/local/bin/eda-sandbox-mcp && chmod +x /usr/local/bin/eda-sandbox-mcp

# This is our wrapper. It must not replace the original v0.1
# /usr/local/bin/eda-container-entrypoint, because the original entrypoint
# starts the bundled Synopsys license server.
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'' \
'export PYTHONPATH="/opt/eda-sandbox:/opt/eda-sandbox/python_deps:${PYTHONPATH:-}"' \
'' \
'if [ -z "${EDA_SANDBOX_PORT:-}" ]; then' \
'  EDA_SANDBOX_PORT="$(/opt/python/bin/python - <<'"'"'PY'"'"'' \
'import random' \
'import socket' \
'for _ in range(100):' \
'    port = random.randint(20000, 29999)' \
'    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:' \
'        try:' \
'            sock.bind(("127.0.0.1", port))' \
'        except OSError:' \
'            continue' \
'        print(port)' \
'        break' \
'else:' \
'    raise SystemExit("failed to find free sandbox port")' \
'PY' \
'  )"' \
'fi' \
'export EDA_SANDBOX_PORT' \
'EDA_SANDBOX_ENDPOINT="http://127.0.0.1:${EDA_SANDBOX_PORT}"' \
'export EDA_SANDBOX_ENDPOINT' \
'echo "${EDA_SANDBOX_ENDPOINT}" > /tmp/eda-sandbox-endpoint' \
'echo "[sandbox-entrypoint] selected EDA_SANDBOX_PORT=${EDA_SANDBOX_PORT}"' \
'' \
'echo "[sandbox-entrypoint] starting eda sandbox daemon..."' \
'start-eda-sandbox > /tmp/eda-sandbox.log 2>&1 &' \
'EDA_SANDBOX_PID=$!' \
'' \
'for i in $(seq 1 60); do' \
'  if curl -fsS "${EDA_SANDBOX_ENDPOINT}/v1/capabilities" >/dev/null 2>&1; then' \
'    echo "[sandbox-entrypoint] eda sandbox daemon is ready at ${EDA_SANDBOX_ENDPOINT}"' \
'    break' \
'  fi' \
'  if ! kill -0 "$EDA_SANDBOX_PID" >/dev/null 2>&1; then' \
'    echo "[sandbox-entrypoint] eda sandbox daemon exited unexpectedly"' \
'    cat /tmp/eda-sandbox.log || true' \
'    exit 1' \
'  fi' \
'  sleep 1' \
'done' \
'' \
'if ! curl -fsS "${EDA_SANDBOX_ENDPOINT}/v1/capabilities" >/dev/null 2>&1; then' \
'  echo "[sandbox-entrypoint] eda sandbox daemon did not become ready at ${EDA_SANDBOX_ENDPOINT}"' \
'  cat /tmp/eda-sandbox.log || true' \
'  exit 1' \
'fi' \
'' \
'echo "[sandbox-entrypoint] ensuring Claude Code onboarding config..."' \
'mkdir -p /home/host' \
'/opt/python/bin/python -c '"'"'import json; from pathlib import Path; p=Path("/home/host/.claude.json"); data={}; data=json.loads(p.read_text(encoding="utf-8")) if p.exists() else {}; data["hasCompletedOnboarding"]=True; p.write_text(json.dumps(data, ensure_ascii=False, indent=2)+"\n", encoding="utf-8")'"'"'' \
'' \
'if command -v claude >/dev/null 2>&1; then' \
'  echo "[sandbox-entrypoint] configuring Claude Code MCP server: eda-sandbox -> ${EDA_SANDBOX_ENDPOINT}"' \
'  claude mcp remove eda-sandbox --scope user >/dev/null 2>&1 || true' \
'  claude mcp add --transport stdio --scope user eda-sandbox -- /usr/local/bin/eda-sandbox-mcp --endpoint "${EDA_SANDBOX_ENDPOINT}" >/dev/null 2>&1 || true' \
'fi' \
'' \
'echo "[sandbox-entrypoint] ready. sandbox endpoint: ${EDA_SANDBOX_ENDPOINT}"' \
'echo "[sandbox-entrypoint] sandbox log: /tmp/eda-sandbox.log"' \
'cd /workspace 2>/dev/null || cd /work 2>/dev/null || cd /' \
'exec "$@"' \
> /usr/local/bin/eda-sandbox-entrypoint && chmod +x /usr/local/bin/eda-sandbox-entrypoint

WORKDIR /workspace

# Do not set ENTRYPOINT here. Inherit the original v0.1 entrypoint:
# /usr/local/bin/eda-container-entrypoint
# The inherited entrypoint starts the bundled Synopsys license server, then
# execs this CMD.
CMD ["/usr/local/bin/eda-sandbox-entrypoint", "/bin/bash"]